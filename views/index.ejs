<!DOCTYPE html>
<html>
<head>
  <title>Speed Test Reports</title>
  <style> 
  body {
  font-family: Arial, sans-serif;
  margin: 20px;
}

table {
  border-collapse: collapse;
}

th, td {
  border: 1px solid #ddd;
  padding: 10px;
  font-size: 10px; 
}

th {
  background-color: #f2f2f2;
  padding: 10px; 
}

tr:nth-child(even) {
  background-color: #f9f9f9;
}

td {
  padding: 10px; 
}

.nav {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 20px;
}

.nav-btn {
  display: inline-block;
  padding: 6px 14px;
  background-color: #f2f2f2;
  border: 1px solid #ccc;
  border-radius: 4px;
  text-decoration: none;
  color: #333;
  font-size: 13px;
}

.nav-btn:hover {
  background-color: #e0e0e0;
}

.nav-btn.disabled {
  color: #aaa;
  border-color: #ddd;
  cursor: default;
  pointer-events: none;
}

.nav-date {
  font-size: 15px;
  font-weight: bold;
  min-width: 110px;
  text-align: center;
}

.empty-state {
  margin-top: 20px;
  color: #888;
  font-size: 13px;
}
  </style>
</head>
<body>
  <h1>Speed Test Reports</h1>

  <div class="nav">
    <a class="nav-btn" href="/?date=<%= prevDate %>">&larr; Previous Day</a>
    <span class="nav-date"><%= selectedDate %></span>
    <% if (!isToday) { %>
      <a class="nav-btn" href="/?date=<%= nextDate %>">Next Day &rarr;</a>
    <% } else { %>
      <span class="nav-btn disabled">Next Day &rarr;</span>
    <% } %>
  </div>

  <% if (data.length === 0) { %>
    <p class="empty-state">No speed test records found for this day.</p>
  <% } else { %>
  <table>
    <thead>
      <tr>
        <th>Time</th>
        <th>Device</th>
        <th>Download Speed</th>
        <th>Upload Speed</th>
        <th>Ping Latency</th>
      </tr>
    </thead>
    <tbody>
      <% function formatDate(date) {
        const formattedDate = new Date(date).toLocaleString('en-US', {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
            hour: '2-digit',
            minute: '2-digit'
        });
    
        return formattedDate;  } %>
      <% data.forEach(item => { %>
        <tr>
          <td><%= formatDate(item._ts * 1000)  %></td>
          <td><%= item.SystemProperties['iothub-connection-device-id']  %></td>
          <td><%= Number(JSON.parse(item.Body).download_speed).toFixed(2) %></td>
          <td><%= Number(JSON.parse(item.Body).upload_speed).toFixed(2) %></td>
          <td><%= Number(JSON.parse(item.Body).ping_latency).toFixed(2) %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  <% } %>
</body>
</html>