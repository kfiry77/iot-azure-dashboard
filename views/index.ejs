<!DOCTYPE html>
<html>
<head>
  <title>Speed Test Reports</title>
  <style> 
  body {
  font-family: Arial, sans-serif;
  margin: 20px;
}

table {
  border-collapse: collapse;
}

th, td {
  border: 1px solid #ddd;
  padding: 10px;
  font-size: 10px; 
}

th {
  background-color: #f2f2f2;
  padding: 10px; 
}

tr:nth-child(even) {
  background-color: #f9f9f9;
}

td {
  padding: 10px; 
}

.nav {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 20px;
}

.nav-btn {
  display: inline-block;
  padding: 6px 14px;
  background-color: #f2f2f2;
  border: 1px solid #ccc;
  border-radius: 4px;
  text-decoration: none;
  color: #333;
  font-size: 13px;
}

.nav-btn:hover {
  background-color: #e0e0e0;
}

.nav-btn.disabled {
  color: #aaa;
  border-color: #ddd;
  cursor: default;
  pointer-events: none;
}

.nav-date {
  font-size: 15px;
  font-weight: bold;
  min-width: 110px;
  text-align: center;
}

.empty-state {
  margin-top: 20px;
  color: #888;
  font-size: 13px;
}

.content-row {
  display: flex;
  gap: 24px;
  align-items: flex-start;
}

.charts-column {
  flex: 1;
  min-width: 400px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
  </style>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
</head>
<body>
  <h1>Speed Test Reports</h1>

  <div class="nav">
    <a class="nav-btn" href="/?date=<%= prevDate %>">&larr; Previous Day</a>
    <span class="nav-date"><%= selectedDate %></span>
    <% if (!isToday) { %>
      <a class="nav-btn" href="/?date=<%= nextDate %>">Next Day &rarr;</a>
    <% } else { %>
      <span class="nav-btn disabled">Next Day &rarr;</span>
    <% } %>
  </div>

  <% if (data.length === 0) { %>
    <p class="empty-state">No speed test records found for this day.</p>
  <% } else { %>
  <div class="content-row">
  <table>
    <thead>
      <tr>
        <th>Time</th>
        <th>Device</th>
        <th>Download Speed</th>
        <th>Upload Speed</th>
        <th>Ping Latency</th>
      </tr>
    </thead>
    <tbody>
      <% function formatDate(date) {
        const formattedDate = new Date(date).toLocaleString('en-US', {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
            hour: '2-digit',
            minute: '2-digit'
        });
    
        return formattedDate;  } %>
      <% data.forEach(item => { %>
        <tr>
          <td><%= formatDate(item._ts * 1000)  %></td>
          <td><%= item.SystemProperties['iothub-connection-device-id']  %></td>
          <td><%= Number(JSON.parse(item.Body).download_speed).toFixed(2) %></td>
          <td><%= Number(JSON.parse(item.Body).upload_speed).toFixed(2) %></td>
          <td><%= Number(JSON.parse(item.Body).ping_latency).toFixed(2) %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  <div class="charts-column">
    <canvas id="speedChart"></canvas>
    <canvas id="latencyChart"></canvas>
  </div>
  </div>

  <script>
    const rows = <%- JSON.stringify(data.map(item => {
      const body = JSON.parse(item.Body);
      return {
        ts: item._ts * 1000,
        download: body.download_speed,
        upload: body.upload_speed,
        latency: body.ping_latency
      };
    })) %>.reverse(); // reverse from DESC to chronological order

    // anchor axis from local midnight so 6h steps land exactly on 00/06/12/18
    const dayStart = new Date(rows[0].ts);
    dayStart.setHours(0, 0, 0, 0);
    const minTs = dayStart.getTime();
    const maxTs = minTs + 24 * 3600 * 1000;
    const SIX_HOURS = 6 * 3600 * 1000;

    const sharedX = (showLabels) => ({
      type: 'linear',
      min: minTs,
      max: maxTs,
      ticks: {
        stepSize: SIX_HOURS,
        maxRotation: 0,
        minRotation: 0,
        display: showLabels,
        callback: val => new Date(val).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' })
      },
      grid: { color: 'rgba(0,0,0,0.07)' }
    });

    new Chart(document.getElementById('speedChart'), {
      type: 'line',
      data: {
        datasets: [
          {
            label: 'Download (Mbps)',
            data: rows.map(r => ({ x: r.ts, y: r.download })),
            borderColor: '#4e79a7',
            backgroundColor: 'rgba(78,121,167,0.08)',
            tension: 0.3,
          },
          {
            label: 'Upload (Mbps)',
            data: rows.map(r => ({ x: r.ts, y: r.upload })),
            borderColor: '#f28e2b',
            backgroundColor: 'rgba(242,142,43,0.08)',
            tension: 0.3,
          }
        ]
      },
      options: {
        responsive: true,
        interaction: { mode: 'index', intersect: false },
        plugins: { title: { display: true, text: 'Download & Upload Speed (Mbps)' } },
        scales: {
          x: sharedX(false), // labels hidden — shown once on latency chart below
          y: {
            title: { display: true, text: 'Speed (Mbps)' },
            beginAtZero: true,
            grid: { display: false },
            afterFit(scale) { scale.width = 60; }
          }
        }
      }
    });

    new Chart(document.getElementById('latencyChart'), {
      type: 'line',
      data: {
        datasets: [
          {
            label: 'Latency (ms)',
            data: rows.map(r => ({ x: r.ts, y: r.latency })),
            borderColor: '#e15759',
            backgroundColor: 'rgba(225,87,89,0.08)',
            tension: 0.3,
          }
        ]
      },
      options: {
        responsive: true,
        interaction: { mode: 'index', intersect: false },
        plugins: { title: { display: true, text: 'Ping Latency (ms)' } },
        scales: {
          x: sharedX(true),
          y: {
            title: { display: true, text: 'Latency (ms)' },
            beginAtZero: true,
            grid: { display: false },
            afterFit(scale) { scale.width = 60; }
          }
        }
      }
    });
  </script>
  <% } %>
</body>
</html>